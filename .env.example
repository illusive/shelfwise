# Shelfwise POC configuration. Copy to `.env.local` for local overrides.
# All VITE_* values are public (bundled into the client). Never put credentials here.

# Analysis provider. Only `mock` exists today; `live` needs a server-side adapter
# (see docs/analysis-contract.md) and is not implemented yet.
VITE_ANALYSIS_PROVIDER=mock

# Simulated mock analysis latency in milliseconds.
VITE_MOCK_LATENCY_MS=2500

# When true, the first mock attempt of each job fails (retryable) to demo recovery.
VITE_MOCK_FAIL_FIRST_ATTEMPT=false

# Docker Compose: LAN IP or hostname to include in the self-signed certificate.
# Example: LAN_HOST=192.168.1.42
LAN_HOST=
HTTPS_PORT=8443
HTTP_PORT=8080

# Public path the app is served from. GitHub Pages builds use /shelfwise/.
BASE_PATH=/

# Target overlap between consecutive shelf photos for the camera overlap guide (0.1–0.5).
VITE_OVERLAP_TARGET=0.25

# Days a visit's photos are kept before local originals may be purged (sent as retainUntil).
VITE_RETENTION_DAYS=365

# Show developer tools (training export) in the user drawer. Per device: open with ?dev=1.
VITE_DEV_TOOLS=false
